    <path
        android:pathData="M 54,42 L 67,46.5 L 67,54"
        android:strokeWidth="1.2"
        android:strokeColor="#FFFBBF24"
        android:strokeLineCap="round" />
    <path
        android:pathData="M 66,54 L 68,54 L 67.5,57 L 66.5,57 Z"
        android:fillColor="#FFF59E0B" />

    <!-- Open Book of Knowledge (Pages Spreading Left & Right) -->
    <!-- Left Page -->
    <path
        android:pathData="M 53,60 C 47,58.5 42,59 38,62 L 38,71 C 42,68 47,67.5 53,69 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38"
                android:startY="60"
                android:endX="53"
                android:endY="71"
                android:type="linear">
                <item android:color="#FF38BDF8" android:offset="0.0" />
                <item android:color="#FF1D4ED8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Right Page -->
    <path
        android:pathData="M 55,60 C 61,58.5 66,59 70,62 L 70,71 C 66,68 61,67.5 55,69 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="70"
                android:startY="60"
                android:endX="55"
                android:endY="71"
                android:type="linear">
                <item android:color="#FF38BDF8" android:offset="0.0" />
                <item android:color="#FF1D4ED8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Book Spine -->
    <path
        android:pathData="M 54,59.5 L 54,70"
        android:strokeWidth="1.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round" />

    <!-- Radiant Gold Apex Star (Excellence & Learning) -->
    <path
        android:pathData="M 54,23 L 55.2,26.5 L 58.5,27.5 L 55.2,28.5 L 54,32 L 52.8,28.5 L 49.5,27.5 L 52.8,26.5 Z"
        android:fillColor="#FFFBBF24" />

    <!-- "EDU" Badge at Bottom -->
    <path
        android:pathData="M 45,74.5 L 63,74.5"
        android:strokeWidth="1.5"
        android:strokeColor="#FF38BDF8"
        android:strokeLineCap="round" />
</vector>
