// AURXON Centralized School & Coaching ERP - Relational Database Schema
// Database Engine: SQLite for development, fully compatible with PostgreSQL in production

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. MULTI-TENANT SAAS PLATFORM
// -------------------------------------------------------------

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  code         String   @unique
  logoUrl      String?
  primaryColor String   @default("#1e3a8a")
  status       String   @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // License & SaaS Subscription Metadata
  licenseKey          String?
  licenseTier         String   @default("ENTERPRISE") // STARTER, GROWTH, ENTERPRISE
  licenseValidUntil   DateTime?
  maxStudents         Int      @default(5000)
  maxStaff            Int      @default(500)
  maxCampuses         Int      @default(10)

  institutions        Institution[]
  users               User[]
  moduleEntitlements  ModuleEntitlement[]
  rolePermissions     RolePermission[]
  academicSessions    AcademicSession[]
  classLevels         ClassLevel[]
  sections            Section[]
  courses             Course[]
  batches             Batch[]
  subjects            Subject[]
  subjectAssignments  SubjectAssignment[]
  students            Student[]
  parentGuardians     ParentGuardian[]
  admissionInquiries  AdmissionInquiry[]
  attendanceRecords   AttendanceRecord[]
  timetableSlots      TimetableSlot[]
  exams               Exam[]
  marksEntries        MarksEntry[]
  feeStructures       FeeStructure[]
  feeAllocations      StudentFeeAllocation[]
  feePayments         FeePayment[]
  financialRecords    FinancialTransaction[]
  announcements       Announcement[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  staffProfiles       StaffProfile[]
  staffDocuments      StaffDocument[]
  studentDocuments    StudentDocument[]
  staffLeaveRequests     StaffLeaveRequest[]
  staffAttendanceRecords StaffAttendanceRecord[]
  studentLeaveRequests   StudentLeaveRequest[]
  approvalRequests       ApprovalRequest[]
}

model ModuleEntitlement {
  id             String   @id @default(cuid())
  organizationId String
  moduleName     String   // TRANSPORT, LIBRARY, HOSTEL, INVENTORY, PAYROLL, LMS
  isEnabled      Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleName])
  @@index([organizationId])
}

// -------------------------------------------------------------
// 2. INSTITUTION & BRANCH HIERARCHY
// -------------------------------------------------------------

model Institution {
  id                String   @id @default(cuid())
  organizationId    String
  name              String
  code              String
  type              String   @default("SCHOOL") // SCHOOL, COACHING, HYBRID
  affiliationNumber String?
  board             String?  // CBSE, ICSE, STATE, NEET_JEE, CAMBRIDGE
  email             String?
  phone             String?
  address           String?
  city              String?
  state             String?
  pincode           String?
  currency          String   @default("INR")
  currencySymbol    String   @default("₹")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches           Branch[]
  users              User[]
  academicSessions   AcademicSession[]
  classLevels        ClassLevel[]
  sections           Section[]
  courses            Course[]
  batches            Batch[]
  subjects           Subject[]
  subjectAssignments SubjectAssignment[]
  students           Student[]
  admissionInquiries AdmissionInquiry[]
  attendanceRecords  AttendanceRecord[]
  timetableSlots     TimetableSlot[]
  exams              Exam[]
  marksEntries       MarksEntry[]
  feeStructures      FeeStructure[]
  feeAllocations     StudentFeeAllocation[]
  feePayments        FeePayment[]
  financialRecords   FinancialTransaction[]
  announcements      Announcement[]
  auditLogs          AuditLog[]
  staffProfiles      StaffProfile[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Branch {
  id             String   @id @default(cuid())
  institutionId  String
  name           String
  code           String
  address        String?
  city           String?
  state          String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  users       User[]
  students    Student[]
  staffProfiles StaffProfile[]

  @@index([institutionId])
}

// -------------------------------------------------------------
// 3. IDENTITY, USERS & RBAC
// -------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  organizationId String
  institutionId  String?
  branchId       String?
  email          String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone               String?
  role                String    // SUPER_ADMIN, ORG_ADMIN, PRINCIPAL, VICE_PRINCIPAL, BRANCH_HEAD, ACADEMIC_COORDINATOR, EXAM_COORDINATOR, TEACHER, FACULTY, ACCOUNTANT, FINANCE_MANAGER, HR_MANAGER, FRONT_OFFICE, LIBRARIAN, TRANSPORT_MANAGER, PARENT, STUDENT
  status              String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  actorType           String?   // PLATFORM, LEADERSHIP, ADMINISTRATION, ACADEMIC, FINANCE, END_USER
  scope               String?   // ORGANIZATION, BRANCH, ASSIGNED_SECTIONS, OWN_CHILDREN, SELF, etc.
  avatarUrl           String?
  mustResetPassword   Boolean   @default(false)
  isTemporaryPassword Boolean   @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution  Institution?  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  subjectAssignments  SubjectAssignment[]
  parentProfile       ParentGuardian?
  studentProfile      Student?
  timetableSlots      TimetableSlot[]
  notifications       Notification[]
  staffProfile        StaffProfile?
  staffResponsibilities StaffResponsibility[]
  approvalsRequested  ApprovalRequest[] @relation("ApprovalsRequested")
  approvalsActed      ApprovalRequest[] @relation("ApprovalsActed")
  userPermissions     UserPermission[]

  @@index([organizationId])
  @@index([institutionId])
  @@index([role])
}

model UserPermission {
  id         String   @id @default(cuid())
  userId     String
  permission String
  granted    Boolean  @default(true) // true = grant override, false = explicit deny
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
}

model RolePermission {
  id             String   @id @default(cuid())
  organizationId String
  role           String
  permission     String   // e.g. "student.create", "attendance.mark", "fee.collect"

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role, permission])
  @@index([organizationId, role])
}

// -------------------------------------------------------------
// 4. ACADEMICS & STRUCTURE (SCHOOL & COACHING MODES)
// -------------------------------------------------------------

model AcademicSession {
  id             String    @id @default(cuid())
  organizationId String
  institutionId  String
  name           String    // e.g. "2025-2026"
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution        Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subjectAssignments SubjectAssignment[]
  students           Student[]
  attendanceRecords  AttendanceRecord[]
  timetableSlots     TimetableSlot[]
  exams              Exam[]
  feeStructures      FeeStructure[]

  @@index([organizationId, institutionId])
}

// School Structure: Class Level (Grade 1-12) & Section (A, B, C)
model ClassLevel {
  id             String   @id @default(cuid())
  organizationId String
  institutionId  String
  name           String   // e.g. "Class 10", "Grade 8"
  code           String   // e.g. "10", "8"
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  sections      Section[]
  feeStructures FeeStructure[]

  @@unique([institutionId, name])
  @@index([organizationId, institutionId])
}

model Section {
  id             String   @id @default(cuid())
  organizationId String
  institutionId  String
  classLevelId   String
  name           String   // e.g. "Section A", "Rose"
  roomNumber     String?
  createdAt      DateTime @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution        Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  classLevel         ClassLevel          @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  students           Student[]
  subjectAssignments SubjectAssignment[]
  attendanceRecords  AttendanceRecord[]
  timetableSlots     TimetableSlot[]
  examSubjects       ExamSubject[]

  @@unique([classLevelId, name])
  @@index([organizationId, institutionId])
}

// Coaching Structure: Program / Course (e.g. JEE Droppers) & Batch (Phoenix Morning)
model Course {
  id             String   @id @default(cuid())
  organizationId String
  institutionId  String
  name           String   // e.g. "JEE Advanced 2-Year Intensive", "NEET Crash Course"
  code           String
  targetExam     String?  // JEE_ADVANCED, NEET, FOUNDATION, UPSC
  description    String?
  createdAt      DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  batches       Batch[]
  feeStructures FeeStructure[]

  @@unique([institutionId, code])
  @@index([organizationId, institutionId])
}

model Batch {
  id             String    @id @default(cuid())
  organizationId String
  institutionId  String
  courseId       String
  name           String    // e.g. "Batch Phoenix 2025", "Morning Spark"
  startDate      DateTime?
  endDate        DateTime?
  maxCapacity    Int       @default(40)
  createdAt      DateTime  @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution        Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  students           Student[]
  subjectAssignments SubjectAssignment[]
  attendanceRecords  AttendanceRecord[]
  timetableSlots     TimetableSlot[]
  examSubjects       ExamSubject[]

  @@unique([courseId, name])
  @@index([organizationId, institutionId])
}

model Subject {
  id             String   @id @default(cuid())
  organizationId String
  institutionId  String
  name           String   // e.g. "Mathematics", "Physics", "English"
  code           String   // e.g. "MATH-10", "PHY-JEE"
  type           String   @default("THEORY") // THEORY, PRACTICAL, HYBRID
  createdAt      DateTime @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution        Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subjectAssignments SubjectAssignment[]
  timetableSlots     TimetableSlot[]
  examSubjects       ExamSubject[]

  @@unique([institutionId, code])
  @@index([organizationId, institutionId])
}

model SubjectAssignment {
  id                String   @id @default(cuid())
  organizationId    String
  institutionId     String
  academicSessionId String
  subjectId         String
  teacherId         String
  sectionId         String?  // For school
  batchId           String?  // For coaching
  createdAt         DateTime @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution     Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher         User            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section         Section?        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  batch           Batch?          @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([organizationId, institutionId])
  @@index([teacherId])
}

// -------------------------------------------------------------
// 5. STUDENT INFORMATION SYSTEM (SIS) & GUARDIANS
// -------------------------------------------------------------

model Student {
  id                String    @id @default(cuid())
  organizationId    String
  institutionId     String
  branchId          String?
  academicSessionId String
  sectionId         String?   // For school
  batchId           String?   // For coaching
  admissionNumber   String    // Unique per organization
  rollNumber        String?
  firstName         String
  lastName          String
  fatherName        String?
  motherName        String?
  fatherOccupation  String?
  motherOccupation  String?
  guardianPhone     String?
  aadharNumber      String?
  religion          String?   // HINDU, MUSLIM, CHRISTIAN, SIKH, JAIN, BUDDHIST, OTHER
  casteCategory     String?   // GENERAL, OBC, SC, ST, EWS
  previousSchool    String?
  tcNumber          String?
  schoolBoard       String?   @default("CBSE")
  dob               DateTime
  gender            String    // MALE, FEMALE, OTHER
  bloodGroup        String?
  category          String?   @default("GENERAL") // GENERAL, OBC, SC, ST, EWS
  nationality       String?   @default("Indian")
  address           String?
  city              String?
  state             String?
  pincode           String?
  contactPhone      String?
  email             String?
  photoUrl          String?
  status            String    @default("ACTIVE") // ACTIVE, ARCHIVED, TRANSFERRED, GRADUATED
  enrollmentDate    DateTime  @default(now())
  userId            String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution       Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch            Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  academicSession   AcademicSession        @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  section           Section?               @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  batch             Batch?                 @relation(fields: [batchId], references: [id], onDelete: SetNull)
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  studentParents    StudentParent[]
  attendanceRecords AttendanceRecord[]
  marksEntries      MarksEntry[]
  feeAllocations    StudentFeeAllocation[]
  feePayments       FeePayment[]
  leaveRequests     StudentLeaveRequest[]
  studentDocuments  StudentDocument[]

  @@unique([organizationId, admissionNumber])
  @@index([organizationId, institutionId])
  @@index([status])
}

model ParentGuardian {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?  @unique // Optional link to login account
  firstName      String
  lastName       String
  relation       String   // FATHER, MOTHER, GUARDIAN
  phone          String
  email          String?
  occupation     String?
  annualIncome   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentParents StudentParent[]

  @@index([organizationId])
}

model StudentParent {
  id                 String   @id @default(cuid())
  studentId          String
  parentId           String
  isPrimaryContact   Boolean  @default(true)
  isEmergencyContact Boolean  @default(true)

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  ParentGuardian @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([studentId])
}

// -------------------------------------------------------------
// 6. ADMISSION WORKFLOW LIFECYCLE
// -------------------------------------------------------------

model AdmissionInquiry {
  id                String    @id @default(cuid())
  organizationId    String
  institutionId     String
  inquiryNumber     String
  applicantName     String
  parentName        String
  phone             String
  email             String?
  targetClass       String?
  targetCourse      String?
  source            String?   @default("WALK_IN") // WALK_IN, WEBSITE, REFERRAL, SOCIAL_MEDIA
  status            String    @default("INQUIRY") // INQUIRY, APPLIED, VERIFIED, INTERVIEWED, APPROVED, ADMITTED, REJECTED
  notes             String?
  followUpDate      DateTime?
  convertedStudentId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, inquiryNumber])
  @@index([organizationId, institutionId])
  @@index([status])
}

// -------------------------------------------------------------
// 7. ATTENDANCE & AUDIT TRACKING
// -------------------------------------------------------------

model AttendanceRecord {
  id                String   @id @default(cuid())
  organizationId    String
  institutionId     String
  academicSessionId String
  studentId         String
  sectionId         String?  // School context
  batchId           String?  // Coaching context
  date              DateTime // Indexed for daily queries
  status            String   // PRESENT, ABSENT, LATE, HALF_DAY, LEAVE
  remarks           String?
  markedById        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution     Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section         Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  batch           Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([organizationId, institutionId, date])
  @@index([sectionId, date])
  @@index([batchId, date])
}

// -------------------------------------------------------------
// 8. TIMETABLE & CONFLICT DETECTION
// -------------------------------------------------------------

model TimetableSlot {
  id                String   @id @default(cuid())
  organizationId    String
  institutionId     String
  academicSessionId String
  dayOfWeek         Int      // 1=Monday, 2=Tuesday, ..., 6=Saturday
  periodNumber      Int      // 1, 2, 3, 4...
  startTime         String   // e.g. "08:30"
  endTime           String   // e.g. "09:15"
  subjectId         String
  teacherId         String
  sectionId         String?  // School context
  batchId           String?  // Coaching context
  roomNumber        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution     Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher         User            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section         Section?        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  batch           Batch?          @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([organizationId, institutionId])
  @@index([teacherId, dayOfWeek, periodNumber])
  @@index([roomNumber, dayOfWeek, periodNumber])
  @@index([sectionId, dayOfWeek, periodNumber])
  @@index([batchId, dayOfWeek, periodNumber])
}

// -------------------------------------------------------------
// 9. EXAMINATIONS, MARKS & DETERMINISTIC REPORT CARDS
// -------------------------------------------------------------

model Exam {
  id                String   @id @default(cuid())
  organizationId    String
  institutionId     String
  academicSessionId String
  name              String   // e.g. "Mid-Term Examination 2025", "JEE Mock Test 04"
  examType          String   // PERIODIC_TEST, HALF_YEARLY, ANNUAL, MOCK_TEST
  startDate         DateTime
  endDate           DateTime
  status            String   @default("DRAFT") // DRAFT, SCHEDULED, ONGOING, COMPLETED, PUBLISHED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution     Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  examSubjects    ExamSubject[]

  @@index([organizationId, institutionId])
}

model ExamSubject {
  id         String    @id @default(cuid())
  examId     String
  subjectId  String
  sectionId  String?
  batchId    String?
  examDate   DateTime?
  maxMarks   Float     @default(100.0)
  passMarks  Float     @default(33.0)
  createdAt  DateTime  @default(now())

  exam         Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section      Section?     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  batch        Batch?       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  marksEntries MarksEntry[]

  @@index([examId])
}

model MarksEntry {
  id             String   @id @default(cuid())
  organizationId String
  institutionId  String
  examSubjectId  String
  studentId      String
  marksObtained  Float
  isAbsent       Boolean  @default(false)
  grade          String?  // A1, A2, B1, B2, C1, etc.
  remarks        String?
  enteredById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  examSubject  ExamSubject  @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examSubjectId, studentId])
  @@index([organizationId, institutionId])
}

// -------------------------------------------------------------
// 10. FEES, PAYMENTS & AUDITABLE FINANCIAL TRANSACTIONS
// -------------------------------------------------------------

model FeeStructure {
  id                String   @id @default(cuid())
  organizationId    String
  institutionId     String
  academicSessionId String
  name              String   // e.g. "Annual Class 10 Fee Schedule"
  classLevelId      String?  // School
  courseId          String?  // Coaching
  totalAmount       Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution     Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicSession AcademicSession        @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  classLevel      ClassLevel?            @relation(fields: [classLevelId], references: [id], onDelete: SetNull)
  course          Course?                @relation(fields: [courseId], references: [id], onDelete: SetNull)
  feeHeads        FeeHead[]
  feeAllocations  StudentFeeAllocation[]

  @@index([organizationId, institutionId])
}

model FeeHead {
  id             String @id @default(cuid())
  feeStructureId String
  title          String // "Tuition Fee", "Lab Fee", "Examination Fee", "Transport"
  amount         Float
  frequency      String @default("ONE_TIME") // ONE_TIME, MONTHLY, QUARTERLY, ANNUAL

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([feeStructureId])
}

model StudentFeeAllocation {
  id             String   @id @default(cuid())
  organizationId String
  institutionId  String
  studentId      String
  feeStructureId String
  grossAmount    Float
  discountAmount Float    @default(0.0) // Scholarship/Concession
  netAmount      Float
  paidAmount     Float    @default(0.0)
  balanceAmount  Float
  status         String   @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERDUE
  dueDate        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  payments     FeePayment[]

  @@index([organizationId, institutionId])
  @@index([studentId])
  @@index([status])
}

model FeePayment {
  id             String   @id @default(cuid())
  organizationId String
  institutionId  String
  studentId      String
  allocationId   String
  receiptNumber  String   // e.g. "REC-2026-0045"
  amount         Float
  paymentMethod  String   // CASH, UPI, NET_BANKING, CHEQUE, CARD
  transactionRef String?
  paymentDate    DateTime @default(now())
  receivedById   String
  remarks        String?
  createdAt      DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution  Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allocation   StudentFeeAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, institutionId])
  @@index([studentId])
}

model FinancialTransaction {
  id             String   @id @default(cuid())
  organizationId String
  institutionId  String
  type           String   // INCOME, EXPENSE
  category       String   // FEE_COLLECTION, SALARY, UTILITIES, MAINTENANCE, SUPPLIES
  amount         Float
  date           DateTime @default(now())
  paymentMethod  String
  referenceNo    String?
  description    String?
  recordedById   String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([organizationId, institutionId])
  @@index([type, date])
}

// -------------------------------------------------------------
// 11. COMMUNICATION & NOTIFICATION SYSTEM
// -------------------------------------------------------------

model Announcement {
  id             String    @id @default(cuid())
  organizationId String
  institutionId  String
  title          String
  content        String
  targetAudience String    @default("ALL") // ALL, TEACHERS, PARENTS, STUDENTS
  priority       String    @default("NORMAL") // NORMAL, URGENT
  publishedAt    DateTime  @default(now())
  expiresAt      DateTime?
  authorId       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([organizationId, institutionId])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String
  message        String
  category       String   @default("SYSTEM") // SYSTEM, ACADEMIC, ATTENDANCE, FEE, NOTICE
  link           String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// -------------------------------------------------------------
// 12. AUDIT LOGGING SYSTEM (IMMUTABLE MUTATION HISTORY)
// -------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  institutionId  String?
  actorId        String
  actorName      String
  actorRole      String
  resource       String   // e.g. "STUDENT", "ATTENDANCE", "FEE_PAYMENT", "EXAM_MARKS"
  action         String   // "CREATE", "UPDATE", "DELETE", "LOGIN", "EXPORT", "PAYMENT_COLLECTED"
  recordId       String?
  detailsJson    String?  // JSON string of before/after or payload details
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution  Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([organizationId, timestamp])
  @@index([resource, recordId])
}

// -------------------------------------------------------------
// 13. STAFF ONBOARDING, PROFESSIONAL PROFILES & HR MANAGEMENT
// -------------------------------------------------------------

model StaffProfile {
  id                     String    @id @default(cuid())
  organizationId         String
  institutionId          String
  branchId               String?
  userId                 String?   @unique
  employeeId             String    // e.g. "EMP-DPS-2026-001"
  firstName              String
  lastName               String
  preferredName          String?
  dob                    DateTime
  gender                 String    // MALE, FEMALE, OTHER
  bloodGroup             String?
  email                  String
  phone                  String
  avatarUrl              String?
  qrCodeDataUrl          String?   // Scannable verification QR Code data URL
  address                String?
  city                   String?
  state                  String?
  pincode                String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  emergencyContactRelation String?

  department             String    // "Mathematics", "Sciences", "Humanities", "Administration", "Accounts & Finance"
  designation            String    // "Principal", "Vice Principal", "PGT Physics", "TGT Mathematics", "Bursar", "Librarian"
  employmentType         String    @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, VISITING, GUEST, INTERN, PROBATION
  joiningDate            DateTime  @default(now())
  reportingManagerId     String?
  status                 String    @default("ACTIVE") // APPLICANT, ONBOARDING, PROBATION, ACTIVE, ON_LEAVE, SUSPENDED, TRANSFERRED, RESIGNED, TERMINATED, RETIRED
  profileCompleteness    Int       @default(0) // 0 - 100 percentage

  // Sensitive Financial & Identity Fields (Strictly Restricted Access)
  basicSalary            Float?
  bankName               String?
  bankAccountNumber      String?
  bankIfsc               String?
  panNumber              String?
  aadhaarNumber          String?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institution            Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch                 Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user                   User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  education              StaffEducation[]
  experience             StaffExperience[]
  teachingExperience     StaffTeachingExperience[]
  skills                 StaffSkill[]
  certifications         StaffCertification[]
  documents              StaffDocument[]
  careerTimeline         StaffCareerEvent[]
  responsibilities       StaffResponsibility[]
  leaveRequests          StaffLeaveRequest[]
  leaveBalances          StaffLeaveBalance[]
  attendanceRecords      StaffAttendanceRecord[]

  @@unique([organizationId, employeeId])
  @@index([organizationId, institutionId])
  @@index([department, status])
}

model StaffEducation {
  id              String   @id @default(cuid())
  staffId         String
  qualification   String   // "Post Graduate", "Graduate", "Doctorate", "Diploma", "Secondary"
  degree          String   // "M.Sc.", "B.Ed.", "Ph.D.", "B.Tech", "M.Com"
  specialization  String   // "Mathematics", "Theoretical Physics", "English Literature"
  institution     String   // "St. Stephen's College", "Delhi University"
  universityBoard String   // "Delhi University", "CBSE"
  passingYear     Int
  percentageGrade String   // "88.5%", "A Grade", "CGPA 9.2"
  certificateUrl  String?
  createdAt       DateTime @default(now())

  staff           StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model StaffExperience {
  id                    String    @id @default(cuid())
  staffId               String
  organizationName      String
  designation           String
  startDate             DateTime
  endDate               DateTime?
  yearsOfExperience     Float
  rolesResponsibilities String?
  reasonForLeaving      String?
  documentUrl           String?
  createdAt             DateTime  @default(now())

  staff                 StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model StaffTeachingExperience {
  id               String   @id @default(cuid())
  staffId          String
  subjectsTaught   String   // "Advanced Mathematics, Calculus, Trigonometry"
  classesTaught    String   // "Class 10, Class 11, Class 12"
  curricula        String   // "CBSE, ICSE, JEE Advanced, NEET, Foundation"
  yearsExperience  Float
  isCoaching       Boolean  @default(false)
  createdAt        DateTime @default(now())

  staff            StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model StaffSkill {
  id          String   @id @default(cuid())
  staffId     String
  category    String   // "SUBJECT", "TECHNOLOGY", "PEDAGOGY", "LANGUAGE", "LEADERSHIP"
  name        String   // "Calculus", "Smartboard Software", "Python", "Hindi", "Classroom Management"
  proficiency String   @default("INTERMEDIATE") // "BEGINNER", "INTERMEDIATE", "ADVANCED", "EXPERT"
  createdAt   DateTime @default(now())

  staff       StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model StaffCertification {
  id                String    @id @default(cuid())
  staffId           String
  title             String    // "CTET Qualified (Level 2)", "Google Certified Educator", "First Aid Specialist"
  issuingAuthority  String    // "CBSE", "Google for Education", "Red Cross"
  issueDate         DateTime
  expiryDate        DateTime?
  certificateNumber String?
  documentUrl       String?
  createdAt         DateTime  @default(now())

  staff             StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model StaffDocument {
  id                String    @id @default(cuid())
  staffId           String
  organizationId    String
  documentType      String    // "RESUME", "DEGREE_CERTIFICATE", "EXPERIENCE_LETTER", "IDENTITY_PROOF", "ADDRESS_PROOF", "OFFER_LETTER", "POLICE_VERIFICATION", "MEDICAL_FITNESS"
  title             String
  fileUrl           String
  fileSize          Int?
  mimeType          String?
  status            String    @default("SUBMITTED") // "NOT_SUBMITTED", "SUBMITTED", "UNDER_REVIEW", "VERIFIED", "REJECTED", "EXPIRED"
  rejectionReason   String?
  verifiedByUserId  String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  staff             StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([organizationId, status])
}

model StudentDocument {
  id                String    @id @default(cuid())
  studentId         String
  organizationId    String
  documentType      String    // "BIRTH_CERTIFICATE", "AADHAR_CARD", "TRANSFER_CERTIFICATE", "CASTE_CERTIFICATE", "INCOME_CERTIFICATE", "MARKSHEET", "PASSPORT_PHOTO", "OTHER"
  title             String
  fileUrl           String
  fileSize          Int?
  mimeType          String?
  status            String    @default("SUBMITTED") // "NOT_SUBMITTED", "SUBMITTED", "VERIFIED", "REJECTED"
  rejectionReason   String?
  verifiedByUserId  String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  student           Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([organizationId, status])
}


model StaffCareerEvent {
  id            String   @id @default(cuid())
  staffId       String
  eventType     String   // "JOINED", "PROMOTED", "TRANSFERRED", "ROLE_CHANGE", "RESPONSIBILITY_ASSIGNED", "RESPONSIBILITY_EXPIRED", "SUSPENDED", "REINSTATED", "EXIT"
  title         String
  description   String
  fromBranchId  String?
  toBranchId    String?
  fromRole      String?
  toRole        String?
  effectiveDate DateTime @default(now())
  createdById   String
  createdAt     DateTime @default(now())

  staff         StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, effectiveDate])
}

model StaffResponsibility {
  id                 String    @id @default(cuid())
  staffId            String
  userId             String?
  responsibilityType String    // "CLASS_TEACHER", "SUBJECT_TEACHER", "EXAM_COORDINATOR", "ACADEMIC_COORDINATOR", "BRANCH_HEAD", "HOD", "TRANSPORT_INCHARGE", "CLASS_MONITOR"
  title              String    // e.g. "Class Teacher - Section 10A"
  scopeLevel         String    // "ORGANIZATION", "INSTITUTION", "BRANCH", "CLASS", "SECTION", "BATCH", "SUBJECT"
  scopeId            String?
  classLevelId       String?
  sectionId          String?
  batchId            String?
  subjectId          String?
  validFrom          DateTime  @default(now())
  validUntil         DateTime?
  isTemporary        Boolean   @default(false)
  status             String    @default("ACTIVE") // "ACTIVE", "EXPIRED", "REVOKED"
  assignedById       String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  staff              StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  user               User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([staffId, status])
  @@index([userId, status])
}

model StaffLeaveRequest {
  id                    String    @id @default(cuid())
  staffId               String
  organizationId        String
  institutionId         String?
  branchId              String?
  academicSessionId     String?
  leaveType             String    // "CASUAL", "SICK", "EARNED", "HALF_DAY", "EMERGENCY", "MATERNITY", "PATERNITY", "UNPAID", "SPECIAL", "DUTY"
  startDate             DateTime
  endDate               DateTime
  totalDays             Float
  halfDay               Boolean   @default(false)
  halfDayPeriod         String?   // "FIRST_HALF", "SECOND_HALF"
  emergency             Boolean   @default(false)
  reason                String
  contactDuringLeave    String?
  supportingDocUrl      String?
  academicImpactJson    String?   // JSON of affected classes/subjects/periods
  substituteStaffId     String?
  suggestedSubstituteId String?
  status                String    @default("PENDING") // "DRAFT", "SUBMITTED", "PENDING", "UNDER_REVIEW", "APPROVED", "REJECTED", "CANCEL_REQUESTED", "CANCELLED", "WITHDRAWN"
  currentReviewStep     String    @default("COORDINATOR") // "COORDINATOR", "HOD", "VICE_PRINCIPAL", "PRINCIPAL"
  reviewedByUserId      String?
  reviewedAt            DateTime?
  reviewRemarks         String?
  workflowStepsJson     String?   // JSON tracking multi-tier approval signatures
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  staff                 StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([staffId, status])
  @@index([organizationId, status])
}

model StaffLeaveBalance {
  id                String   @id @default(cuid())
  staffId           String
  academicSessionId String?
  leaveType         String   // "CASUAL", "SICK", "EARNED", "MATERNITY", "PATERNITY", "UNPAID", "SPECIAL", "DUTY"
  totalAllocated    Float
  usedDays          Float    @default(0)
  pendingDays       Float    @default(0)
  availableDays     Float
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  staff             StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, leaveType, academicSessionId])
  @@index([staffId])
}

model StaffAttendanceRecord {
  id                String   @id @default(cuid())
  organizationId    String
  institutionId     String?
  branchId          String?
  staffId           String
  date              DateTime
  status            String   // "PRESENT", "ABSENT", "LATE", "HALF_DAY", "LEAVE"
  leaveRequestId    String?
  remarks           String?
  markedById        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff             StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([organizationId, date])
  @@index([staffId, status])
}

model StudentLeaveRequest {
  id                  String   @id @default(cuid())
  organizationId      String
  institutionId       String?
  academicSessionId   String?
  studentId           String
  appliedByUserId     String   // Parent or Student user ID
  appliedByRole       String   // "PARENT" or "STUDENT"
  leaveType           String   // "SICK", "MEDICAL", "CASUAL", "FAMILY_EMERGENCY", "PLANNED_ABSENCE", "BEREAVEMENT"
  startDate           DateTime
  endDate             DateTime
  totalDays           Float
  reason              String
  parentConfirmation  Boolean  @default(true)
  hasExamConflict     Boolean  @default(false)
  examConflictDetails String?
  supportingDocUrl    String?
  status              String   @default("PENDING") // "PENDING", "UNDER_REVIEW", "APPROVED", "REJECTED", "WITHDRAWN", "CANCELLED"
  reviewedByUserId    String?
  reviewedAt          DateTime?
  reviewRemarks       String?
  currentReviewStep   String   @default("CLASS_TEACHER") // "CLASS_TEACHER", "COORDINATOR", "VICE_PRINCIPAL", "PRINCIPAL"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student             Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([studentId, status])
}

// -------------------------------------------------------------
// 14. FOUR-EYES APPROVAL WORKFLOW ENGINE
// -------------------------------------------------------------

model ApprovalRequest {
  id                      String    @id @default(cuid())
  organizationId          String
  institutionId           String?
  workflowType            String    // "ATTENDANCE_CORRECTION", "FEE_ADJUSTMENT", "FEE_REFUND", "FEE_CONCESSION", "EXAM_PUBLICATION", "STAFF_TRANSFER", "STAFF_LEAVE_ESCALATION", "STUDENT_LEAVE_ESCALATION", "ROLE_CHANGE", "SENSITIVE_DOC_VERIFICATION"
  title                   String
  description             String
  payloadJson             String    // JSON state of requested change
  requesterUserId         String
  targetResourceId        String?
  status                  String    @default("PENDING") // "PENDING", "UNDER_REVIEW", "APPROVED", "REJECTED", "CANCELLED"
  currentStep             String    @default("INITIAL_REVIEW") // "INITIAL_REVIEW", "FINANCE_MANAGER", "HOD", "VICE_PRINCIPAL", "PRINCIPAL"
  stepsJson               String?   // JSON array of defined workflow steps
  actionHistoryJson       String?   // JSON array of approvals/reviews performed
  requiresFourEyesApproval Boolean  @default(true)
  approverUserId          String?
  approvalRemarks         String?
  actedAt                 DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester               User         @relation("ApprovalsRequested", fields: [requesterUserId], references: [id], onDelete: Cascade)
  approver                User?        @relation("ApprovalsActed", fields: [approverUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([requesterUserId])
}
